{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Tymetry Exchange Format v1",
  "type":"object",
  "additionalProperties":false,
  "required":["format","version","exported_at","source","selection","todos"],
  "properties":{
    "format":{"const":"tymx"},
    "version":{"const":1},
    "exported_at":{"type":"string","format":"date-time"},
    "source":{"type":"object","additionalProperties":false,"required":["application"],"properties":{"application":{"const":"Tymetry"}}},
    "selection":{"type":"string","enum":["selected","all_active"]},
    "todos":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["public_id","base","data"],"properties":{"public_id":{"type":"string","format":"uuid"},"base":{"$ref":"#/$defs/fields"},"data":{"$ref":"#/$defs/fields"}}}}
  },
  "$defs":{"fields":{"type":"object","additionalProperties":false,"required":["title","description","status","priority","due_date","due_time"],"properties":{"title":{"type":"string","minLength":1,"maxLength":255},"description":{"type":["string","null"]},"status":{"type":"string","enum":["pending","in_progress","done"]},"priority":{"type":"string","enum":["low","medium","high"]},"due_date":{"type":["string","null"],"format":"date"},"due_time":{"type":["string","null"],"pattern":"^(?:[01]\\d|2[0-3]):[0-5]\\d$"}}}}
}
